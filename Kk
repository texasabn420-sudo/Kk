	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 0.4
	label.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextSize = 14
	label.Font = Enum.Font.GothamBold
	label.Text = text
	label.Parent = gui
	gui.Parent = adornee
	return gui, label
end

local function distTo(pos)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return "?" end
	return tostring(math.floor((hrp.Position - pos).Magnitude)) .. "m"
end

local function refreshESP()
	for plr, data in pairs(playerLabels) do
		local char = plr.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp or not plr.Parent then
			if data.gui then data.gui:Destroy() end
			playerLabels[plr] = nil
		else
			data.label.Text = plr.Name .. " (" .. distTo(hrp.Position) .. ")"
		end
	end
	if espPlayersOn then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player and not playerLabels[plr] then
				local char = plr.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if hrp then
					local gui, label = makeLabel(hrp, plr.Name)
					playerLabels[plr] = { gui = gui, label = label }
				end
			end
		end
	end
	for model, data in pairs(tableLabels) do
		if not model.Parent then
			if data.gui then data.gui:Destroy() end
			tableLabels[model] = nil
		else
			data.label.Text = model.Name .. " (" .. distTo(data.pos) .. ")"
		end
	end
end

local function scanTables()
	for _, inst in ipairs(Workspace:GetDescendants()) do
		if inst:IsA("Model") and string.match(inst.Name, "^Table_%d+$") and not tableLabels[inst] then
			local anchor = inst.PrimaryPart
			if not anchor then
				for _, d in ipairs(inst:GetDescendants()) do
					if d:IsA("BasePart") then
						anchor = d
						break
					end
				end
			end
			if anchor then
				local pos = anchor.Position
				local gui, label = makeLabel(anchor, inst.Name)
				tableLabels[inst] = { gui = gui, label = label, pos = pos }
			end
		end
	end
	local n = 0
	for _ in pairs(tableLabels) do n = n + 1 end
	log("Table ESP scan done (" .. n .. " tables tracked)")
end

local function clearESP(tbl)
	for _, data in pairs(tbl) do
		if data.gui then data.gui:Destroy() end
	end
	table.clear(tbl)
end

-- ================= movement =================
local function applySpeed()
	if not speedOn then return end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = 60
	end
end

local function setNoclip(on)
	noclipOn = on
	if on then
		if noclipConn then noclipConn:Disconnect() end
		noclipConn = RunService.Stepped:Connect(function()
			local char = player.Character
			if not char then return end
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end)
	elseif noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end
end

local function setInfJump(on)
	infJumpOn = on
	if on then
		if jumpConn then jumpConn:Disconnect() end
		jumpConn = UserInputService.JumpRequest:Connect(function()
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end)
	elseif jumpConn then
		jumpConn:Disconnect()
		jumpConn = nil
	end
end

