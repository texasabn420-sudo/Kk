-- ================= helpers =================
local function short(v, depth)
	depth = depth or 0
	local t = typeof(v)
	if t == "string" then
		if #v > 100 then return '"' .. string.sub(v, 1, 100) .. '..."' end
		return '"' .. v .. '"'
	elseif t == "number" or t == "boolean" then
		return tostring(v)
	elseif t == "table" then
		if depth > 0 then return "table{...}" end
		local keys = {}
		local n = 0
		for k in pairs(v) do
			n = n + 1
			if #keys < 10 then keys[#keys + 1] = tostring(k) end
		end
		return "table(" .. n .. " keys: " .. table.concat(keys, ", ") .. ")"
	elseif t == "Instance" then
		return v.ClassName .. ":" .. v.Name
	else
		return t
	end
end

local function findRemote(name)
	if remoteCache[name] then return remoteCache[name] end
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	local found = folder and folder:FindFirstChild(name)
	if not found then
		for _, inst in ipairs(ReplicatedStorage:GetDescendants()) do
			if inst.Name == name and (inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction")) then
				found = inst
				break
			end
		end
	end
	if found then
		remoteCache[name] = found
		log("remote " .. name .. " found at " .. found:GetFullName())
	else
		log("remote " .. name .. " NOT FOUND")
	end
	return found
end

local function setStatus(text)
	if statusLabel then
		statusLabel.Text = text
	end
	log(text)
end

local function showResult(name, ok, res)
	if not ok then
		setStatus(name .. " error: " .. string.sub(tostring(res), 1, 90))
		return
	end
	if type(res) == "table" then
		local keys = {}
		local n = 0
		for k in pairs(res) do
			n = n + 1
			if #keys < 10 then keys[#keys + 1] = tostring(k) end
		end
		setStatus(name .. " ok (" .. n .. " keys: " .. table.concat(keys, ", ") .. ")")
		local shown = 0
		for k, v in pairs(res) do
			shown = shown + 1
			if shown > 30 then break end
			print(TAG .. name .. "." .. tostring(k) .. " = " .. short(v))
		end
	else
		setStatus(name .. " ok: " .. short(res))
	end
end

-- Dashboard reads are throttled: GetRuntimeState is server rate-limited.
local function dashboard(name)
	if os.clock() - lastInvokeAt < 1 then
		setStatus("wait a sec (rate limit)")
		return
	end
	lastInvokeAt = os.clock()
	local r = findRemote(name)
	if not r then
		setStatus(name .. " not found")
		return
	end
	if not r:IsA("RemoteFunction") then
		setStatus(name .. " is not a RemoteFunction")
		return
	end
	local ok, res = pcall(r.InvokeServer, r)
	showResult(name, ok, res)
end

local function fireRemote(name, ...)
	local r = findRemote(name)
	if not r then
		setStatus(name .. " not found")
		return false
	end
	if not r:IsA("RemoteEvent") then
		setStatus(name .. " is not a RemoteEvent")
		return false
	end
	local ok, err = pcall(r.FireServer, r, ...)
	if not ok then
		setStatus(name .. " fire failed: " .. string.sub(tostring(err), 1, 80))
		return false
	end
	return true
end

-- Scan a signal payload for match/token/poll ids (field names vary).
local function scanIds(tbl, depth, budget)
	if type(tbl) ~= "table" or depth > 2 or budget[1] <= 0 then return end
	for k, v in pairs(tbl) do
		budget[1] = budget[1] - 1
		if budget[1] <= 0 then return end
		local lk = string.lower(tostring(k))
		if (lk == "logicalmatchid" or lk == "matchid" or lk == "match") and (type(v) == "string" or type(v) == "number") then
			lastMatchId = v
		elseif (lk == "runtoken" or lk == "token") and (type(v) == "string" or type(v) == "number") then
			lastRunToken = v
		elseif (lk == "pollid" or lk == "poll_id") and (type(v) == "string" or type(v) == "number") then
			lastPollId = v
		elseif type(v) == "table" then
			scanIds(v, depth + 1, budget)
		end
	end
end

local function onSignal(...)
	local args = table.pack(...)
	local payload = args[1]
	local kind = "?"
	if type(payload) == "table" then
		kind = tostring(payload.kind or payload.type or "?")
		scanIds(payload, 0, { 300 })
	end
	if signalOn then
		log("[Signal] kind=" .. kind .. " payload=" .. short(payload))
		if lastMatchId or lastRunToken then
			log("[Signal] stored match/token: " .. tostring(lastMatchId) .. " / " .. tostring(lastRunToken))
		end
		if lastPollId then
			log("[Signal] stored poll id: " .. tostring(lastPollId))
		end
	end
end

local function connectSignal()
	if signalConn then return end
	local r = findRemote("ClientSignal")
	if not r then
		setStatus("ClientSignal not found")
		return false
	end
	signalConn = r.OnClientEvent:Connect(onSignal)
	log("Signal watch connected (always stores match/token/poll ids)")
	return true
end

-- ================= remote spy (observation only) =================
local function argSummary(args)
	local parts = {}
	for i, a in ipairs(args) do
		if i > 5 then break end
		parts[#parts + 1] = short(a)
	end
	local s = table.concat(parts, " | ")
	if #s > 400 then s = string.sub(s, 1, 400) .. "..." end
	return s
end

local function setSpy(on)
	spyOn = on
	if not on then return end
	if spyOld then return end
	local ok, mt = pcall(getrawmetatable, game)
	if not ok or not mt then
		setStatus("Spy unavailable in this executor")
		return
	end
	pcall(setreadonly, mt, false)
	spyOld = mt.__namecall
	local wrap = newcclosure or function(f) return f end
	mt.__namecall = wrap(function(self, ...)
		local method = getnamecallmethod()
		if spyOn and (method == "FireServer" or method == "InvokeServer") then
			local nm = self.Name
			if nm ~= "MouseTarget" then
				if method == "InvokeServer" then
					local res = table.pack(spyOld(self, ...))
					log("[Spy] " .. method .. " " .. self.ClassName .. ":" .. nm .. " args: " .. argSummary(table.pack(...)) .. " -> " .. argSummary(res))
					return table.unpack(res, 1, res.n)
				else
					log("[Spy] " .. method .. " " .. self.ClassName .. ":" .. nm .. " args: " .. argSummary(table.pack(...)))
				end
			end
		end
		return spyOld(self, ...)
	end)
	pcall(setreadonly, mt, true)
	log("Remote Spy hooked (MouseTarget excluded)")
end

